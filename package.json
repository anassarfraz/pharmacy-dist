{
  "name": "pharmacy-management-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/show-ip.js && next dev -H 0.0.0.0",
    "dev:db": "node scripts/show-ip.js && set DEMO_MODE=false&& next dev -H 0.0.0.0",
    "build": "node scripts/build.js",
    "start": "node scripts/show-ip.js && next start -H 0.0.0.0",
