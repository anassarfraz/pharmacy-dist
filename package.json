    "lint": "next lint",
    "ip": "node scripts/show-ip.js",
    "network": "node scripts/show-ip.js",
    "setup": "node scripts/setup.js",
    "db:seed": "node scripts/seed-superadmin.js",
    "db:migrate": "node scripts/migrate-multi-store.js",
    "db:init-settings": "node scripts/init-settings.js",
    "db:seed-medicines": "node scripts/seed-medicines-from-csv.js",
    "db:clear-transactions": "node scripts/clear-transactions.js",
    "test:db": "node scripts/test-connection.js",
    "test:routes": "node scripts/test-routes.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "publish:dist": "node scripts/publish-dist.js",
    "verify": "node scripts/verify-setup.js"
  },
  "dependencies": {
